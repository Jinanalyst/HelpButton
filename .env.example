# Anthropic API key — used only by the serverless function at /api/classify.
# NEVER prefix with VITE_ — that would expose it to the browser bundle.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: pin a model override. Defaults to claude-opus-4-7.
# ANTHROPIC_MODEL=claude-opus-4-7

# OpenAI key — used by /api/stt (Whisper) and /api/tts.
OPENAI_API_KEY=sk-...

# Resend email — used by /api/notify-payment to alert the admin when a user
# claims they paid. Without these, the endpoint returns 500 and the client
# falls back to "알림 설정이 아직 안 됐어요." (plan still activates locally).
RESEND_API_KEY=re_...
ADMIN_EMAIL=jangj6091@gmail.com
# Optional. Defaults to "헬프버튼 <onboarding@resend.dev>" (Resend sandbox sender;
# only delivers to the Resend account owner's verified address — fine for
# solo admin alerts. Verify a custom domain in Resend to send from your own.).
# RESEND_FROM=헬프버튼 <noreply@yourdomain.com>
